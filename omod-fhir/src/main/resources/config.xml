<!DOCTYPE module PUBLIC "-//OpenMRS//DTD OpenMRS Config 1.0//EN"
        "https://resources.openmrs.org/doctype/config-1.6.dtd">
<module configVersion="1.6">

    <id>${project.parent.artifactId}-fhir</id>
    <name>${project.parent.name} FHIR Extensions</name>
    <version>${project.parent.version}</version>
    <package>${project.parent.groupId}.${project.parent.artifactId}.fhir</package>
    <author>OpenMRS Platform Team</author>
    <description>
        Optional FHIR support for the ${project.parent.name} module that activates when the FHIR2 module is running.
    </description>
    <require_version>2.0.5 - 2.*</require_version>

    <require_modules>
        <require_module>org.openmrs.module.fhir2</require_module>
        <require_module>${project.parent.groupId}.${project.parent.artifactId}</require_module>
    </require_modules>

    <aware_of_modules>
        <aware_of_module>org.openmrs.module.webservices.rest</aware_of_module>
    </aware_of_modules>

    <springConfiguration>
        <springContext>moduleApplicationContext</springContext>
    </springConfiguration>
</module>
